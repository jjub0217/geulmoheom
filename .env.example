# 복사해서 .env 로 사용. 값은 절대 커밋하지 않는다.

# ── 데이터 ──
DATABASE_URL=postgresql+asyncpg://geulmoheom:geulmoheom@localhost:5432/geulmoheom
REDIS_URL=redis://localhost:6379/0

# ── LLM (PRD 9장: Evaluator/GM = claude-opus-5) ──
ANTHROPIC_API_KEY=
EVALUATOR_MODEL=claude-opus-5
GM_MODEL=claude-opus-5

# ── 이미지 (W1 벤치 후 확정) ──
IMAGE_PROVIDER=          # fal | replicate
IMAGE_API_KEY=
IMAGE_MODEL=

# ── 스토리지 (Cloudflare R2) ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=geulmoheom-artworks
R2_PUBLIC_BASE_URL=

# ── 앱 ──
APP_ENV=dev              # dev | pilot
JWT_SECRET=
DAILY_CARD_CAP=5
DAILY_COST_ALERT_USD=20  # PRD F-3 비용 알람

# ── web ──
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

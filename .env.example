# 복사해서 .env 로 사용. 값은 절대 커밋하지 않는다.
#
# 환경마다 파일을 나눈다. 서버는 .env 를 읽은 뒤 .env.{APP_ENV} 를 덮어쓴다 —
# APP_ENV=pilot 이면 .env → .env.pilot 순이고 뒤가 이긴다.
# 파일럿용 템플릿은 .env.pilot.example.
#
# APP_ENV 만은 파일이 아니라 **프로세스 환경 변수**로 준다. 어느 파일을 읽을지
# 정하는 값이라 파일 안에 적으면 늦다:  APP_ENV=pilot uv run uvicorn app.main:app

# ── 데이터 (포트는 infra/docker-compose.yml 주석 참조. 기본 포트는 이 머신에서 이미 점유됨) ──
DATABASE_URL=postgresql+asyncpg://geulmoheom:geulmoheom@localhost:5433/geulmoheom
REDIS_URL=redis://localhost:6381/0

# ── LLM (PRD 9장: Evaluator/GM = claude-opus-5) ──
ANTHROPIC_API_KEY=
EVALUATOR_MODEL=claude-opus-5
GM_MODEL=claude-opus-5

# ── 이미지 (W1 벤치 후 확정) ──
IMAGE_PROVIDER=          # fal | replicate
IMAGE_API_KEY=
IMAGE_MODEL=

# ── 스토리지 (Cloudflare R2) ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=geulmoheom-artworks
R2_PUBLIC_BASE_URL=

# ── 앱 ──
APP_ENV=dev              # dev | pilot
JWT_SECRET=
DAILY_CARD_CAP=5
DAILY_COST_ALERT_USD=20  # PRD F-3 비용 알람

# ── web ──
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

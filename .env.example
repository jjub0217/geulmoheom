# 복사해서 .env 로 사용. 값은 절대 커밋하지 않는다.
#
# 환경마다 파일을 나눈다. 서버는 .env 를 읽은 뒤 .env.{APP_ENV} 를 덮어쓴다 —
# APP_ENV=pilot 이면 .env → .env.pilot 순이고 뒤가 이긴다.
# 파일럿용 템플릿은 .env.pilot.example.
#
# APP_ENV 만은 파일이 아니라 **프로세스 환경 변수**로 준다. 어느 파일을 읽을지
# 정하는 값이라 파일 안에 적으면 늦다:  APP_ENV=pilot uv run uvicorn app.main:app

# ── 데이터 (포트는 infra/docker-compose.yml 주석 참조. 기본 포트는 이 머신에서 이미 점유됨) ──
DATABASE_URL=postgresql+asyncpg://geulmoheom:geulmoheom@localhost:5433/geulmoheom
REDIS_URL=redis://localhost:6381/0

# ── LLM — Google Gemini (docs/adr/0005) ──
# **유료 티어 키를 쓴다.** 무료 티어는 입력이 제품 개선에 활용되어
# 아이 원문 라벨링 동의 게이트(PRD 1.1b)를 깬다.
GEMINI_API_KEY=
# Evaluator 는 W2 벤치로 확정 (api/benchmarks/W2-evaluator-bench.md).
# 일치율 97.5% · 최대 1,361ms · 회당 $0.000518.
EVALUATOR_MODEL=gemini-3.1-flash-lite
# Stage 1 GM 은 아직 미정이다. 임시로 적어 넣으면 그게 사실상의 결정이 된다.
GM_MODEL=

# ── 이미지 ──
# W1 벤치로 확정 (adr/0006 · api/benchmarks/W1-image-bench.md).
# **키는 따로 없다.** 이미지도 Gemini 네이티브라 위 GEMINI_API_KEY 하나를 쓴다.
IMAGE_MODEL=gemini-3.1-flash-lite-image

# ── 스토리지 (Cloudflare R2) ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=geulmoheom-artworks
# 공개 base URL 은 없다 — 버킷을 공개하지 않고 api 가 프록시한다
# (2026-09-08 대표 판정, 미결 11-7 · docs/api/Stage0.md 5절)

# ── 앱 ──
APP_ENV=dev              # dev | pilot
JWT_SECRET=
DAILY_CARD_CAP=5
DAILY_COST_ALERT_USD=20  # PRD F-3 비용 알람

# ── web ──
# 개발 환경은 https + .test 다 (docs/api/공통규약.md 「인증 쿠키 · 개발 환경도 https다」).
# 인증서와 /etc/hosts 는 `make certs` 가 깔아 준다. localhost 로 되돌리면
# __Host- 쿠키가 브라우저에 따라 안 붙는다.
NEXT_PUBLIC_API_BASE_URL=https://api.geulmoheom.test:8000/api/v1

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install --frozen-lockfile",
  "build": {
    "env": {
      "NEXT_PUBLIC_API_BASE_URL": "/api/v1"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://geulmoheom-api.onrender.com/api/:path*"
    },
    {
      "source": "/healthz",
      "destination": "https://geulmoheom-api.onrender.com/healthz"
    }
  ]
}

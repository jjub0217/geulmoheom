{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install --frozen-lockfile",
  "build": {
    "env": {
      "NEXT_PUBLIC_API_BASE_URL": "/api/v1"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://API_HOST_를_아직_안_정했다/api/:path*"
    }
  ]
}

# 파일럿 환경 덮어쓰기 템플릿. 복사해서 .env.pilot 로 쓴다.
#
# 서버는 .env 를 먼저 읽고 이 파일로 덮어쓴다 — 여기에는 **dev 와 다른 것만** 적는다.
# 실행:  APP_ENV=pilot uv run uvicorn app.main:app
#
# pilot 은 아래 여덟이 비어 있으면 **뜨지 않는다** (app/config.py PILOT_REQUIRED) —
# GEMINI_API_KEY · JWT_SECRET · EVALUATOR_MODEL · IMAGE_MODEL · S3 셋 · CLIENT_IP_HEADER.
# 조용히 떠서 아이 문장을 받아 놓고 Evaluator 호출에서 터지는 것보다 낫다.

APP_ENV=pilot

# ── 데이터 (파일럿 인스턴스. 로컬 도커가 아니다) ──
DATABASE_URL=
REDIS_URL=

# ── LLM (Google Gemini, **유료 티어**. adr/0005) ──
GEMINI_API_KEY=
EVALUATOR_MODEL=
GM_MODEL=

# ── 이미지 (W1 벤치로 확정. adr/0006) ──
# **키가 따로 없다** — 이미지도 Gemini 네이티브라 위 GEMINI_API_KEY 하나를 쓴다.
# IMAGE_PROVIDER·IMAGE_API_KEY 는 2026-09-07 에 없앴다 (adr/0006).
IMAGE_MODEL=

# ── 스토리지 (AWS S3) ──
# ⛔ 값을 여기 적지 않는다. 이 파일은 커밋된다 — 검사가 막는다
#    (api/tests/test_env_pilot_example.py). 채우는 곳은 .env.pilot 과 Render 대시보드다.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
# 공개 base URL 은 없다 — 버킷을 공개하지 않고 api 가 프록시한다
# (2026-09-08 대표 판정, 미결 11-7 · docs/api/Stage0.md 5절)

# ── 앱 ──
JWT_SECRET=
# 앞단이 **덮어쓰는** 클라이언트 IP 헤더 이름. `/child/auth` 속도 제한이 쓴다
# (docs/api/공통규약.md 「/child/auth 속도 제한」 ②).
# Cloudflare 뒤면 CF-Connecting-IP · Fly 면 Fly-Client-IP.
# **X-Forwarded-For 를 적지 않는다** — 클라이언트가 직접 채워 보낼 수 있어 제한을 비껴간다.
# **pilot 에서는 비워 두면 서버가 안 뜬다** — 비면 모든 요청이 앞단 IP 하나로 뭉쳐
# 시간당 30회가 전체 사용자에게 걸린다.
CLIENT_IP_HEADER=
DAILY_COST_ALERT_USD=20

# ── web ──
NEXT_PUBLIC_API_BASE_URL=

# 파일럿 환경 덮어쓰기 템플릿. 복사해서 .env.pilot 로 쓴다.
#
# 서버는 .env 를 먼저 읽고 이 파일로 덮어쓴다 — 여기에는 **dev 와 다른 것만** 적는다.
# 실행:  APP_ENV=pilot uv run uvicorn app.main:app
#
# pilot 은 ANTHROPIC_API_KEY · IMAGE_API_KEY · JWT_SECRET 이 비어 있으면
# **뜨지 않는다** (app/config.py). 조용히 떠서 아이 문장을 받아 놓고
# Evaluator 호출에서 터지는 것보다 낫다.

APP_ENV=pilot

# ── 데이터 (파일럿 인스턴스. 로컬 도커가 아니다) ──
DATABASE_URL=
REDIS_URL=

# ── LLM ──
ANTHROPIC_API_KEY=

# ── 이미지 (W1 벤치 후 확정) ──
IMAGE_PROVIDER=
IMAGE_API_KEY=
IMAGE_MODEL=

# ── 스토리지 ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# ── 앱 ──
JWT_SECRET=
DAILY_COST_ALERT_USD=20

# ── web ──
NEXT_PUBLIC_API_BASE_URL=
